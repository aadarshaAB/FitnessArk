<?xml version="1.0" encoding="utf-8"?>
<!--
  Fitness Ark icon: 108x108 adaptive foreground
  Visual concept:
    - A stylised ark (boat hull + single sail) in the upper portion
    - A rising fitness progress trend-line cutting through the hull
    - Colour: hull = white/light, trend-line = cyan (#00E5FF)
    - Safe zone = centre 72x72 (18dp inset each side)
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- ── Ark Hull ── -->
    <!-- Main hull body - wide curved boat shape -->
    <path
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.95"
        android:pathData="
          M22,62
          Q24,58 30,56
          L78,56
          Q84,58 86,62
          L82,72
          Q54,66 26,72
          Z" />

    <!-- Hull shading bottom strip -->
    <path
        android:fillColor="#00E5FF"
        android:fillAlpha="0.30"
        android:pathData="
          M26,72
          Q54,66 82,72
          L80,75
          Q54,69 28,75
          Z" />

    <!-- ── Mast ── -->
    <path
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.90"
        android:pathData="M52,56 L52,28 L56,28 L56,56 Z" />

    <!-- ── Sail (main) — filled white with cyan highlight ── -->
    <!-- Billowing sail shape -->
    <path
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.95"
        android:pathData="
          M56,30
          Q72,34 74,46
          Q72,52 56,55
          Z" />

    <!-- Sail inner shading / dimension -->
    <path
        android:fillColor="#00E5FF"
        android:fillAlpha="0.20"
        android:pathData="
          M56,34
          Q68,38 70,47
          Q68,51 56,53
          Z" />

    <!-- Small secondary sail (jib) -->
    <path
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.75"
        android:pathData="
          M52,33
          Q42,40 44,52
          L52,55
          Z" />

    <!-- ── Fitness trend-line (upward arrow path) ── -->
    <!-- Glowing cyan line crossing the hull diagonally upward -->
    <!-- Shadow/glow layer -->
    <path
        android:strokeColor="#00E5FF"
        android:strokeWidth="5"
        android:strokeAlpha="0.25"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="@android:color/transparent"
        android:pathData="M23,72 L36,62 L47,67 L62,53 L75,57 L86,44" />

    <!-- Main trend line -->
    <path
        android:strokeColor="#00E5FF"
        android:strokeWidth="3"
        android:strokeAlpha="0.95"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="@android:color/transparent"
        android:pathData="M23,72 L36,62 L47,67 L62,53 L75,57 L86,44" />

    <!-- Arrowhead at tip -->
    <path
        android:fillColor="#00E5FF"
        android:fillAlpha="0.95"
        android:pathData="
          M86,44
          L80,46
          L83,51
          Z" />

    <!-- ── Water waves beneath hull ── -->
    <!-- Wave 1 -->
    <path
        android:strokeColor="#00E5FF"
        android:strokeWidth="2"
        android:strokeAlpha="0.50"
        android:strokeLineCap="round"
        android:fillColor="@android:color/transparent"
        android:pathData="M20,78 Q31,75 42,78 Q53,81 64,78 Q75,75 86,78" />

    <!-- Wave 2 (smaller, below) -->
    <path
        android:strokeColor="#00E5FF"
        android:strokeWidth="1.5"
        android:strokeAlpha="0.28"
        android:strokeLineCap="round"
        android:fillColor="@android:color/transparent"
        android:pathData="M24,83 Q35,80 46,83 Q57,86 68,83 Q79,80 88,83" />

    <!-- ── Dot markers on trend line (data points) ── -->
    <path android:fillColor="#00E5FF" android:pathData="M36,62m-2.5,0a2.5,2.5 0 1,1 5,0a2.5,2.5 0 1,1 -5,0" />
    <path android:fillColor="#00E5FF" android:pathData="M47,67m-2.5,0a2.5,2.5 0 1,1 5,0a2.5,2.5 0 1,1 -5,0" />
    <path android:fillColor="#00E5FF" android:pathData="M62,53m-2.5,0a2.5,2.5 0 1,1 5,0a2.5,2.5 0 1,1 -5,0" />
    <path android:fillColor="#00E5FF" android:pathData="M75,57m-2.5,0a2.5,2.5 0 1,1 5,0a2.5,2.5 0 1,1 -5,0" />

</vector>
