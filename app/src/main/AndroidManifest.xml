<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <!-- F5: daily check-in reminder notification. Requested at runtime from Settings (API 33+). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      F11: in-app camera (CameraX) for pose capture, front lens + timer by default.
      Unlike the old removed CAMERA declaration (Q1), this one is paired with a genuine runtime
      request (see CheckinScreen) made only the first time "Take Photo" is tapped — declaring it
      without requesting it is what made the system camera throw SecurityException before.
    -->
    <uses-permission android:name="android.permission.CAMERA" />

    <application
        android:name=".FitnessArkApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="Fitness Ark"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.FitnessArk">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- F6: home-screen widget (streak, today's weight, quick "Log weight" button) -->
        <receiver
            android:name=".ui.widget.FitnessArkWidgetReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/fitness_ark_widget_info" />
        </receiver>

    </application>

</manifest>
